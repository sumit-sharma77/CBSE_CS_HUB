# ─── Database ─────────────────────────────────────────────────
POSTGRES_DB=cbsecshub
POSTGRES_USER=cbsecshub
POSTGRES_PASSWORD=changeme_strong_password

# Spring datasource (used by cbse-api service)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/cbsecshub
SPRING_DATASOURCE_USERNAME=cbsecshub
SPRING_DATASOURCE_PASSWORD=changeme_strong_password

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=replace_with_at_least_32_char_random_secret_here!
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ─── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200

# ─── Razorpay ──────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ─── Mail (Gmail SMTP) ─────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM=your@gmail.com

# ─── App ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARN
USER_RETENTION_DAYS=30
SWAGGER_ENABLED=false
SPRING_PROFILES_ACTIVE=docker
